REMY_DATABASE_URL=postgresql://localhost:5432/remy_main
REMY_CORS_ORIGINS=http://localhost:3000,http://localhost:3100
REMY_BLOOM_CAPACITY=100000
REMY_BLOOM_ERROR_RATE=0.01
REMY_JWT_SECRET=
REMY_JWT_TTL_SECONDS=43200
REMY_JWT_RENEW_WITHIN_SECONDS=1800
REMY_JWT_EXPIRED_GRACE_SECONDS=604800

# Session cookie. The JWT is stored here, not in localStorage: HttpOnly keeps it
# out of reach of JavaScript, so an XSS bug cannot read it.
REMY_COOKIE_NAME=remy_session

# Must be true wherever the site is served over HTTPS. A Secure cookie is not
# sent over plain http, so leave it false for local development.
REMY_COOKIE_SECURE=false

# "strict" never attaches the cookie to a request originating from another
# site, which rules out CSRF. The app and the API share a site here (ports do
# not count), so the SPA's own fetches still carry it. Trade-off: someone
# arriving from an external link lands logged out on that first navigation -
# harmless for this SPA, since the session is checked by fetch after the page
# loads, not by the HTML request itself. If you split app and API across
# domains this must become "none", which requires Secure and reopens CSRF.
REMY_COOKIE_SAMESITE=strict
