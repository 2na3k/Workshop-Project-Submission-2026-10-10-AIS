[importlinter]
root_packages =
    domain
    workflows
    api
    app

[importlinter:contract:domain-leaf]
name = domain is a leaf
type = forbidden
source_modules =
    domain
forbidden_modules =
    workflows
    api
    app

[importlinter:contract:workflows-not-api]
name = workflows does not depend on api
type = forbidden
source_modules =
    workflows
forbidden_modules =
    api
    app

[importlinter:contract:api-not-app]
name = api does not depend on app
type = forbidden
source_modules =
    api
forbidden_modules =
    app

[importlinter:contract:api-not-workflows]
name = api does not depend on workflows
type = forbidden
source_modules =
    api
forbidden_modules =
    workflows
