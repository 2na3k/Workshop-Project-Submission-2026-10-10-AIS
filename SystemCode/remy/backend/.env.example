# Point at the database created by db.sql.
REMY_DATABASE_URL=postgresql://localhost:5432/remy_main

# Origins allowed to call this API (the Next.js dev server).
REMY_CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Bloom filter sizing. Capacity is the number of accounts you expect, not the
# number you have: the false positive rate only holds up to capacity.
REMY_BLOOM_CAPACITY=100000
REMY_BLOOM_ERROR_RATE=0.01
