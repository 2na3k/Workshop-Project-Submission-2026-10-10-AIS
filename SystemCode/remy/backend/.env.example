REMY_DATABASE_URL=postgresql://localhost:5432/remy_main
REMY_CORS_ORIGINS=http://localhost:3000,http://localhost:3100REMY_BLOOM_CAPACITY=100000
REMY_BLOOM_ERROR_RATE=0.01
REMY_JWT_SECRET=
REMY_JWT_TTL_SECONDS=43200
REMY_JWT_RENEW_WITHIN_SECONDS=1800
REMY_JWT_EXPIRED_GRACE_SECONDS=604800

# Session cookie. The JWT is stored here, not in localStorage: HttpOnly keeps it
# out of reach of JavaScript, so an XSS bug cannot read it.
REMY_COOKIE_NAME=remy_session

# Must be true wherever the site is served over HTTPS. A Secure cookie is not
# sent over plain http, so leave it false for local development.
REMY_COOKIE_SECURE=false

# "lax" is correct while the API and the app share a site - different ports on
# localhost count as one site. If you split them across domains (api.example.com
# vs app.example.com) this has to become "none", which requires Secure and
# removes the CSRF protection Lax was providing; add CSRF tokens at that point.
REMY_COOKIE_SAMESITE=lax
