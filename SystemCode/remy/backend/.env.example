# Copy to .env and fill in. Under Docker Compose, REMY_DATABASE_URL and
# REMY_CORS_ORIGINS are set by docker-compose.yml and the values here are ignored.

# Signs sign-in sessions. Generate one with: openssl rand -base64 48
REMY_JWT_SECRET=

# Only used when the backend runs outside Docker.
REMY_DATABASE_URL=postgresql://localhost:5432/remy_main
REMY_CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Optional. These are the defaults.
REMY_JWT_TTL_SECONDS=43200
REMY_JWT_RENEW_WITHIN_SECONDS=1800
REMY_JWT_EXPIRED_GRACE_SECONDS=604800
REMY_BLOOM_CAPACITY=100000
REMY_BLOOM_ERROR_RATE=0.01
